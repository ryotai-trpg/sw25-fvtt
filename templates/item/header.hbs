{{!-- アイテムシート(ApplicationV2)の共通ヘッダ。

     画像・名前・編集トグルはどの型でも同じ。型ごとに違うのは
     見出し下(subtitle)と右肩(activate)だけなので、そこを
     `templates/item/header/<type>.hbs` に切り出して差し込む。
     差し込む相手は `SW25ItemSheetV2#_prepareContext` が
     アイテムの type から組み立てる(`headerSlot`)。 --}}
<header class="header">
  <section class="header__img">
    <img class="profile-img" src="{{document.img}}" data-edit="img" data-action="editImage"
         alt="{{document.name}}" title="{{document.name}}"/>
  </section>

  <section class="header__title">
    <h1 class="charname">
      {{#if isEdit}}
        {{formInput fields.name value=source.name placeholder=(localize "DOCUMENT.FIELDS.name.label")
                    aria=(object label=(localize "DOCUMENT.FIELDS.name.label"))}}
      {{else if titleSlot}}
        {{!-- 名前の前後にバッジを出す型(魔法のアイテム、武器の種別など)は
              閲覧時の見出しごと templates/item/title/<type>.hbs が持つ --}}
        {{> (lookup . "titleSlot")}}
      {{else}}
        {{document.name}}
      {{/if}}
    </h1>
  </section>

  {{> (lookup . "headerSlot")}}

  <section class="togglearea">
    <label class="togglearea__btn">
      <input id="{{document.id}}isEdit" type="checkbox" name="system.isEdit"
             {{checked isEdit}} data-dtype="Boolean"/>
      <div class="togglearea__btn--slider"><i class="fa-solid fa-wrench"></i></div>
    </label>
  </section>
</header>
