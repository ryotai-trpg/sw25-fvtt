{{!-- monsterability の詳細タブ。共通部分は parts/detail-*.hbs。 --}}
<section class="tab {{tab.id}} {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

      {{> "systems/sw25/templates/item/parts/detail-basic.hbs"}}

      {{!-- MonsterAbility Category --}}
      <fieldset class="category flexrow grid grid-10col">
        <legend class="category__title">
          {{localize "SW25.Item.Field.MonsterAbility"}}
        </legend>
        <div class="grid-span-10 property">
          <label class="property--label" for="{{docId}}system.remark">{{localize "SW25.Item.Monsterability.Remark"}}</label>
          <input class="property--value" id="{{docId}}system.remark" type="text" name="system.remark" value="{{system.remark}}" data-dtype="String" {{disabled (not isEdit)}}/>
        </div>

        {{!-- Elements Category --}}
        <div class="grid-span-10">
          {{> "systems/sw25/templates/item/parts/item-elements.hbs" isMagic=true isPhysical=true}}
        </div>

        {{> "systems/sw25/templates/item/parts/detail-timing.hbs"}}

        {{> "systems/sw25/templates/item/parts/detail-resource.hbs" hpcost=true maxhpcost=true mpcost=true resuse=true}}
      </fieldset>

      {{!-- Use-dice1 Category --}}
      <fieldset class="category">
        <legend class="category__title">
          <input class="checkbox--hidden" id="{{docId}}system.usedice1" type="checkbox" name="system.usedice1" data-dtype="Boolean" {{checked system.usedice1}} {{disabled (not isEdit)}}/>
          <label class="checkbox--label" for="{{docId}}system.usedice1">{{localize "SW25.Item.Monsterability.Check1"}}</label>
        </legend>
        <div style="display: {{#if system.usedice1}}block{{else}}none{{/if}};">
          <div class="flexrow grid grid-8col">
            <span class="resource-label" style="text-decoration: underline;">{{localize "SW25.Check"}}1</span>
            <span class="grid-span-3" style="text-align: left;"><label for="{{docId}}system.label1"><b>{{localize "SW25.Item.Monsterability.Label"}}</b></label>
              <input id="{{docId}}system.label1" style="max-width: calc(60% - 7px);" type="text" name="system.label1" value="{{system.label1}}" data-dtype="String" {{disabled (not isEdit)}}/></span>
            <span class="grid-span-2" style="text-align: left;">{{localize "SW25.Basenumber"}}{{localize "SW25.Value"}} : <b>{{system.checkbase1}} ({{system.checkbasefix1}})</b></span>
            <span class="grid-span-2" style="text-align: left;">
              <select name="system.applycheck1" {{disabled (not isEdit)}}>
                {{selectOptions applyOptions selected=system.applycheck1 localize=true}}
              </select>
            </span>
          </div>
          <div class="flexrow grid grid-8col">
            <span style="text-align: center;"><label for="{{docId}}system.checkbasemod1"><b>{{localize "SW25.Basenumber"}}</b></label><br>
              <input id="{{docId}}system.checkbasemod1" type="text" name="system.checkbasemod1" value="{{system.checkbasemod1}}" data-dtype="Number" {{disabled (not isEdit)}}/></span>
            <span style="text-align: center;"><label for="{{docId}}system.usefix1"><b>{{localize "SW25.Item.Monsterability.Usefix"}}</b></label><br>
              <input id="{{docId}}system.usefix1" type="checkbox" name="system.usefix1" data-dtype="Boolean" {{checked system.usefix1}} {{disabled (not isEdit)}}/></span>
            <span style="text-align: center;"><label for="{{docId}}system.checkmod1"><b>{{localize "SW25.Modifier"}}</b></label><br>
              <input id="{{docId}}system.checkmod1" type="text" name="system.checkmod1" value="{{system.checkmod1}}" data-dtype="Number" {{disabled (not isEdit)}}/></span>
            <div class="grid-span-2 flex-group-center">
              <span style="text-align: center;"><label for="{{docId}}system.customdice1"><b>{{localize "SW25.Item.Customdice"}}</b></label><br>
                <input id="{{docId}}system.customdice1" type="checkbox" name="system.customdice1" data-dtype="Boolean" {{checked system.customdice1}} {{disabled (not isEdit)}}/></span>
            </div>
            <div class="grid-span-3" style="display: {{#if system.customdice1}}block{{else}}none{{/if}};">
              <label for="{{docId}}system.customformula1" class="resource-label">{{localize "SW25.Item.Formula"}}</label>
              <input id="{{docId}}system.customformula1" type="text" name="system.customformula1" value="{{system.customformula1}}" data-dtype="String" {{disabled (not isEdit)}}/>
            </div>
            <div class="grid-span-2">
            </div>
          </div>
          {{!-- Resist Category --}}
          <fieldset class="subcategory flexrow grid grid-10col">
            <legend class="category__title">
              {{localize "SW25.Item.Field.Resist"}}
            </legend>
            <div class="grid-span-2 flex-group-center">
              <span style="text-align: center;"><label for="{{docId}}system.dice1.resist.type"><b>{{localize "SW25.Item.Resisttype"}}</b></label><br>
              <select id="{{docId}}system.dice1.resist.type" name="system.dice1.resist.type" {{disabled (not isEdit)}}>
                {{selectOptions config.resistCheck selected=system.dice1.resist.type localize=true blank="-"}}
              </select>
            </div>
            {{#if (eq system.dice1.resist.type "input")}}
            <div class="grid-span-3" style="display: {{#if system.dice1.resist.type}}block{{else}}none{{/if}};">
              <label for="{{docId}}system.dice1.resist.input" class="resource-label">{{localize "SW25.Item.Resistinput"}}</label>
              <input id="{{docId}}system.dice1.resist.input" type="text" name="system.dice1.resist.input" value="{{system.dice1.resist.input}}" data-dtype="String" {{disabled (not isEdit)}}/>
            </div>
            {{/if}}
            <div class="grid-span-3">
              <span style="text-align: center;"><label for="{{docId}}system.dice1.resist.result"><b>{{localize "SW25.Item.Resist"}}</b></label><br>
              <select id="{{docId}}system.dice1.resist.result" name="system.dice1.resist.result" {{disabled (not isEdit)}}>
                {{selectOptions config.resistResult selected=system.dice1.resist.result localize=true blank="-"}}
              </select>
            </div>
          </fieldset>
        </div>
      </fieldset>

