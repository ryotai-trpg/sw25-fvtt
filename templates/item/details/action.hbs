{{!-- action の詳細タブ。共通部分は parts/detail-*.hbs。 --}}
<section class="tab {{tab.id}} {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

      {{!-- 行動は自己バフを持たないので、共通の detail-basic.hbs は使わない --}}
      <fieldset class="category flexrow grid grid-10col">
        <legend class="category__title">{{localize "SW25.Item.Field.Basic"}}</legend>
        <div class="grid-span-5 property">
          <label class="property--label">{{localize "SW25.Item.Clickitem"}}</label>
          <select class="property--value" name="system.clickitem" {{disabled (not isEdit)}}>
            {{selectOptions clickitemOptions selected=system.clickitem localize=true}}
          </select>
        </div>
        <div class="grid-span-5 blank"></div>
        <div class="grid-span-10 property">
          <label class="property--label" for="{{docId}}system.overview">{{localize "SW25.Item.Overview"}}</label>
          <input class="property--value" id="{{docId}}system.overview" type="text"
                 name="system.overview" value="{{system.overview}}" data-dtype="String" {{disabled (not isEdit)}}/>
        </div>
      </fieldset>

      {{!-- Action Category --}}
      <fieldset class="category flexrow grid grid-10col">
        <legend class="category__title">
          {{localize "SW25.Item.Field.Action"}}
        </legend>

        <div class="grid-span-3 property">
          <label class="property--label">{{localize "SW25.ActionTable"}}</label>
          <select class="property--value" name="system.actiondice" {{disabled (not isEdit)}}>
            <option value=""{{#unless system.actiondice}} selected{{/unless}}>-</option>
            <option value="f1"{{#if (eq system.actiondice "f1")}} selected{{/if}}>{{localize "SW25.Fellow"}}:1-2</option>
            <option value="f3"{{#if (eq system.actiondice "f3")}} selected{{/if}}>{{localize "SW25.Fellow"}}:3-4</option>
            <option value="f5"{{#if (eq system.actiondice "f5")}} selected{{/if}}>{{localize "SW25.Fellow"}}:5</option>
            <option value="f6"{{#if (eq system.actiondice "f6")}} selected{{/if}}>{{localize "SW25.Fellow"}}:6</option>
            <option value="d1"{{#if (eq system.actiondice "d1")}} selected{{/if}}>{{localize "SW25.Daemon"}}:1</option>
            <option value="d2"{{#if (eq system.actiondice "d2")}} selected{{/if}}>{{localize "SW25.Daemon"}}:2-3</option>
            <option value="d4"{{#if (eq system.actiondice "d4")}} selected{{/if}}>{{localize "SW25.Daemon"}}:4-5</option>
            <option value="d6"{{#if (eq system.actiondice "d6")}} selected{{/if}}>{{localize "SW25.Daemon"}}:6</option>
          </select>
        </div>
        <div class="grid-span-2 property">
          {{#if system.actiondice}}
          <label class="property--label">{{localize "SW25.Item.Action.ActionResult"}}</label>
          <select class="property--value" name="system.actionresult" {{disabled (not isEdit)}}>
            {{#if (eq system.actiondice "f1")}}
            <option value="7"{{#if (eq system.actionresult "7")}} selected{{/if}}>7</option>
            <option value="6"{{#if (eq system.actionresult "6")}} selected{{/if}}>6</option>
            {{/if}}
            {{#if (eq system.actiondice "f3")}}
            <option value="8"{{#if (eq system.actionresult "8")}} selected{{/if}}>8</option>
            <option value="5"{{#if (eq system.actionresult "5")}} selected{{/if}}>5</option>
            {{/if}}
            {{#if (eq system.actiondice "f5")}}
            <option value="9"{{#if (eq system.actionresult "9")}} selected{{/if}}>9</option>
            <option value="4"{{#if (eq system.actionresult "4")}} selected{{/if}}>4</option>
            {{/if}}
            {{#if (eq system.actiondice "f6")}}
            <option value="10"{{#if (eq system.actionresult "10")}} selected{{/if}}>10</option>
            <option value="3"{{#if (eq system.actionresult "3")}} selected{{/if}}>3</option>
            {{/if}}
            {{#if (eq system.actiondice "d1")}}
            <option value="8"{{#if (eq system.actionresult "8")}} selected{{/if}}>8</option>
            {{/if}}
            {{#if (eq system.actiondice "d2")}}
            <option value="8"{{#if (eq system.actionresult "8")}} selected{{/if}}>8</option>
            {{/if}}
            {{#if (eq system.actiondice "d4")}}
            <option value="9"{{#if (eq system.actionresult "9")}} selected{{/if}}>9</option>
            {{/if}}
            {{#if (eq system.actiondice "d6")}}
            <option value="10"{{#if (eq system.actionresult "10")}} selected{{/if}}>10</option>
            {{/if}}
          </select>
          {{/if}}
        </div>
        <div class="grid-span-5 property">
          <label class="property--label" for="{{docId}}system.target">{{localize "SW25.Target"}}</label>
          <input class="property--value" id="{{docId}}system.target" type="text" name="system.target" value="{{system.target}}" data-dtype="String" {{disabled (not isEdit)}}/>
        </div>

        <div class="grid-span-10 property">
          <label class="property--label" for="{{docId}}system.dialog">{{localize "SW25.Item.Action.Dialog"}}</label>
          <input class="property--value" id="{{docId}}system.dialog" type="text" name="system.dialog" value="{{system.dialog}}" data-dtype="String" {{disabled (not isEdit)}}/>
        </div>
        <div class="grid-span-10 property">
          <label class="property--label" for="{{docId}}system.action">{{localize "SW25.Item.Action.Action"}}</label>
          <textarea class="property--value textarea-editor" id="{{docId}}system.action" data-path="action" {{disabled (not isEdit)}}>{{system.action}}</textarea>
        </div>
        <div class="grid-span-10 property">
          <label class="property--label" for="{{docId}}system.actioneffect">{{localize "SW25.Item.Action.ActionEffect"}}</label>
          <textarea class="property--value textarea-editor" id="{{docId}}system.actioneffect" data-path="actioneffect" {{disabled (not isEdit)}}>{{system.actioneffect}}</textarea>
        </div>

        {{> "systems/sw25/templates/item/parts/detail-resource.hbs" hpcost=true maxhpcost=true mpcost=true resuse=true}}
      </fieldset>

      {{!-- Use-ActionValue Category --}}
      <fieldset class="category">
        <legend class="category__title">
          <input class="checkbox--hidden" id="{{docId}}system.usedice1" type="checkbox" name="system.usedice1" data-dtype="Boolean" {{checked system.usedice1}} {{disabled (not isEdit)}}/>
          <label class="checkbox--label" for="{{docId}}system.usedice1">{{localize "SW25.Item.Action.ActionValue"}}</label>
        </legend>
        <div style="display: {{#if system.usedice1}}block{{else}}none{{/if}};">
          <div class="flexrow grid grid-10col">
            <span class="resource-label grid-span-2" style="text-decoration: underline;">{{localize "SW25.Item.Action.ActionValue"}}{{localize "SW25.Setting"}}</span>
            <span class="grid-span-2" style="text-align: left;">{{localize "SW25.Item.Action.ActionValue"}}{{localize "SW25.Basenumber"}} : <b>{{system.checkbase1}}</b></span>
            {{!--
            <span class="grid-span-2" style="text-align: left;">
              <select name="system.applycheck1">
                {{selectOptions applyOptions selected=system.applycheck1 localize=true}}
              </select>
            </span>
            --}}
            <span class="grid-span-2"></span>
            <span class="grid-span-4">
              {{#if (eq system.applycheck1 "custom")}}
              <div class="flexcol">
                <div>
                  <label for="{{docId}}ckpdbt1"><input id="{{docId}}ckpdbt1" type="checkbox" class="small-checkbox" name="system.ckpdbt1" data-dtype="Boolean" {{checked system.ckpdbt1}}/>{{localize "SW25.Item.pd"}}</label>
                  <label for="{{docId}}ckmdbt1"><input id="{{docId}}ckmdbt1" type="checkbox" class="small-checkbox" name="system.ckmdbt1" data-dtype="Boolean" {{checked system.ckmdbt1}}/>{{localize "SW25.Item.md"}}</label>
                  <label for="{{docId}}ckcdbt1"><input id="{{docId}}ckcdbt1" type="checkbox" class="small-checkbox" name="system.ckcdbt1" data-dtype="Boolean" {{checked system.ckcdbt1}}/>{{localize "SW25.Item.cd"}}</label>
                </div>
                <div>
                  <label for="{{docId}}ckhrbt1"><input id="{{docId}}ckhrbt1" type="checkbox" class="small-checkbox" name="system.ckhrbt1" data-dtype="Boolean" {{checked system.ckhrbt1}}/>{{localize "SW25.Item.hr"}}</label>
                  <label for="{{docId}}ckmrbt1"><input id="{{docId}}ckmrbt1" type="checkbox" class="small-checkbox" name="system.ckmrbt1" data-dtype="Boolean" {{checked system.ckmrbt1}}/>{{localize "SW25.Item.mr"}}</label>
                </div>
              </div>
              {{/if}}
            </span>
          </div>
          <div class="flexrow grid grid-8col">
            <span class="grid-span-2" style="text-align: center;"><b>{{localize "SW25.Item.Action.ActionValue"}}{{localize "SW25.Skillname"}}</b><br>
              <select name="system.checkskill1">
                <option value="">-</option>
                <option value="adv" {{#if (eq system.checkskill1 "adv")}}selected{{/if}}>{{localize "SW25.Attributes.Advlevel"}}</option>
                {{selectOptions system.skilllist selected=system.checkskill1 valueAttr="name" labelAttr="name"}}
              </select>
            </span>
            <span class="grid-span-2" style="text-align: center;"><b>{{localize "SW25.Item.Action.ActionValue"}}{{localize "SW25.Abilityname"}}</b><br>
              <select name="system.checkabi1">
                {{selectOptions config.abilities selected=system.checkabi1 localize=true blank="-"}}
              </select>
            </span>
            <span class="grid-span-2" style="text-align: center;"><label for="{{docId}}system.checkmod1"><b>{{localize "SW25.Basenumber"}}{{localize "SW25.Value"}}</b></label><br>
              <input id="{{docId}}system.checkmod1" style="max-width: calc(50% - 7px);" type="text" name="system.checkmod1" value="{{system.checkmod1}}" data-dtype="Number"/></span>
            <div class="grid-span-2"></div>

            <div class="grid-span-2 flex-group-center">
              <span style="text-align: center;"><label for="{{docId}}system.dice1.resist.type"><b>{{localize "SW25.Item.Resisttype"}}</b></label><br>
              <select id="{{docId}}system.dice1.resist.type" name="system.dice1.resist.type">
                {{selectOptions config.resistCheck selected=system.dice1.resist.type localize=true blank="-"}}
              </select>
            </div>
            {{#if (eq system.dice1.resist.type "input")}}
            <div class="grid-span-3" style="display: {{#if system.dice1.resist.type}}block{{else}}none{{/if}};">
              <label for="{{docId}}system.dice1.resist.input" class="resource-label">{{localize "SW25.Item.Resistinput"}}</label>
              <input id="{{docId}}system.dice1.resist.input" type="text" name="system.dice1.resist.input" value="{{system.dice1.resist.input}}" data-dtype="String"/>
            </div>
            {{/if}}
            <div class="grid-span-4">
              <span style="text-align: center;"><label for="{{docId}}system.dice1.resist.result"><b>{{localize "SW25.Item.Resisttype"}}</b></label><br>
              <select id="{{docId}}system.dice1.resist.result" name="system.dice1.resist.result">
                {{selectOptions config.resistResult selected=system.dice1.resist.result localize=true blank="-"}}
              </select>
            </div>
          </div>
          {{!--
          <div class="flexcol grid grid-8col nogapmargin">
            <div class="grid-span-2 flex-group-center">
              <span style="text-align: center;"><label for="{{docId}}system.customdice1"><b>{{localize "SW25.Item.Customdice"}}</b></label><br>
                <input id="{{docId}}system.customdice1" type="checkbox" name="system.customdice1" data-dtype="Boolean" {{checked system.customdice1}}/></span>
            </div>
            <div class="grid-span-4" style="display: {{#if system.customdice1}}block{{else}}none{{/if}};">
              <label for="{{docId}}customformula1" class="resource-label">{{localize "SW25.Item.Formula"}}</label>
              <input id="{{docId}}customformula1" type="text" name="system.customformula1" value="{{system.customformula1}}" data-dtype="String"/>
            </div>
            <div class="grid-span-2">
            </div>
          </div>
          --}}
        </div>
      </fieldset>

      {{> "systems/sw25/templates/item/parts/detail-rolls.hbs" withResist=true}}
</section>
