{{!-- weapon の詳細タブ。

     基本設定・魔法のアイテム欄・リソース設定・判定/威力設定は装備品系で
     共通なので `parts/detail-*.hbs` に切り出してある。ここに残るのは
     武器固有の並び(分類・階級・価格・種別・用法・必筋・命中・追加D・射程)だけ。
     属性は V1 と同じ `parts/item-elements.hbs` をそのまま使う。 --}}
<section class="tab {{tab.id}} {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  {{> "systems/sw25/templates/item/parts/detail-basic.hbs"}}

  <fieldset class="category flexrow grid grid-10col">
    <legend class="category__title">{{localize "SW25.Item.Field.Item"}}</legend>

    <div class="grid-span-4 property">
      <label class="property--label" for="{{docId}}system.category">{{localize "SW25.Item.Category"}}</label>
      <select class="property--value" id="{{docId}}system.category" name="system.category" {{disabled (not isEdit)}}>
        {{selectOptions config.weaponCategories selected=system.category localize=true blank="-"}}
      </select>
    </div>
    <div class="grid-span-1 property">
      <select class="property--value" name="system.rank" {{disabled (not isEdit)}}>
        {{selectOptions config.ranks selected=system.rank blank="-"}}
      </select>
    </div>
    <div class="grid-span-5 property">
      <label class="property--label" for="{{docId}}system.price">{{localize "SW25.Item.Price"}}</label>
      <input class="property--value" id="{{docId}}system.price" type="text"
             name="system.price" value="{{system.price}}" data-dtype="Number" {{disabled (not isEdit)}}/>
    </div>

    {{> "systems/sw25/templates/item/parts/detail-magicitem.hbs"}}

    <div class="grid-span-2 property-col">
      <label class="property--label-col" for="{{docId}}system.type">{{localize "SW25.Item.Weapon.Type"}}</label>
      <select class="property--value" id="{{docId}}system.type" name="system.type" {{disabled (not isEdit)}}>
        {{selectOptions config.weaponTypes selected=system.type localize=true blank="-"}}
      </select>
    </div>
    <div class="grid-span-2 property-col">
      <label class="property--label-col" for="{{docId}}system.usage">{{localize "SW25.Item.Weapon.Usage"}}</label>
      <select class="property--value" id="{{docId}}system.usage" name="system.usage" {{disabled (not isEdit)}}>
        {{selectOptions config.weaponUsages selected=system.usage localize=true blank="-"}}
      </select>
    </div>
    <div class="grid-span-1 property-col">
      <label class="property--label-col" for="{{docId}}system.reqstr">{{localize "SW25.Item.Reqstr"}}</label>
      <input class="property--value" id="{{docId}}system.reqstr" type="text"
             name="system.reqstr" value="{{system.reqstr}}" data-dtype="Number" {{disabled (not isEdit)}}/>
    </div>
    <div class="grid-span-1 property-col">
      <label class="property--label-col" for="{{docId}}system.hit">{{localize "SW25.Item.Weapon.Hit"}}</label>
      <input class="property--value" id="{{docId}}system.hit" type="text"
             name="system.hit" value="{{system.hit}}" data-dtype="Number" {{disabled (not isEdit)}}/>
    </div>
    <div class="grid-span-1 property-col">
      <label class="property--label-col" for="{{docId}}system.dmod">{{localize "SW25.Item.Weapon.Dmod"}}</label>
      <input class="property--value" id="{{docId}}system.dmod" type="text"
             name="system.dmod" value="{{system.dmod}}" data-dtype="Number" {{disabled (not isEdit)}}/>
    </div>
    <div class="grid-span-3 property-col">
      <label class="property--label-col" for="{{docId}}system.range">{{localize "SW25.Item.Weapon.Range"}}</label>
      <input class="property--value" id="{{docId}}system.range" type="text"
             name="system.range" value="{{system.range}}" data-dtype="String" {{disabled (not isEdit)}}/>
    </div>

    <div class="grid-span-10">
      {{> "systems/sw25/templates/item/parts/item-elements.hbs" isMagic=true isPhysical=true}}
    </div>

    {{> "systems/sw25/templates/item/parts/detail-resource.hbs" hpcost=true maxhpcost=true mpcost=true resuse=true}}
  </fieldset>

  {{> "systems/sw25/templates/item/parts/detail-rolls.hbs"}}
</section>
