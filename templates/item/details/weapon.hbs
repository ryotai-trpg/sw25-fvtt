{{!-- weapon の詳細タブ。

     属性・判定設定・威力設定は V1 と同じ共有パーシャルをそのまま使う。
     パーシャル側の `{{item._id}}` は `{{docId}}` に置き換えてあり、
     V1 シートも同じ名前で渡すので 1 組で足りる。 --}}
<section class="tab {{tab.id}} {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  {{!-- Basic Category --}}
  <fieldset class="category flexrow grid grid-10col">
    <legend class="category__title">{{localize "SW25.Item.Field.Basic"}}</legend>
    <div class="grid-span-5 property">
      <label class="property--label">{{localize "SW25.Item.Clickitem"}}</label>
      <select class="property--value" name="system.clickitem" {{disabled (not isEdit)}}>
        {{selectOptions clickitemOptions selected=system.clickitem localize=true}}
      </select>
    </div>
    <div class="blank"></div>
    <div class="grid-span-2">
      <input class="checkbox--hidden" id="{{docId}}system.selfbuff" type="checkbox"
             name="system.selfbuff" data-dtype="Boolean" {{checked system.selfbuff}} {{disabled (not isEdit)}}/>
      <label class="checkbox--label" for="{{docId}}system.selfbuff">{{localize "SW25.Item.Selfbuff"}}</label>
    </div>
    <div class="blank grid-span-2"></div>
    <div class="grid-span-10 property">
      <label class="property--label" for="{{docId}}system.overview">{{localize "SW25.Item.Overview"}}</label>
      <input class="property--value" id="{{docId}}system.overview" type="text"
             name="system.overview" value="{{system.overview}}" data-dtype="String" {{disabled (not isEdit)}}/>
    </div>
  </fieldset>

  {{!-- Item Category --}}
  <fieldset class="category flexrow grid grid-10col">
    <legend class="category__title">{{localize "SW25.Item.Field.Item"}}</legend>

    <div class="grid-span-4 property">
      <label class="property--label" for="{{docId}}system.category">{{localize "SW25.Item.Category"}}</label>
      <select class="property--value" id="{{docId}}system.category" name="system.category" {{disabled (not isEdit)}}>
        {{selectOptions config.weaponCategories selected=system.category localize=true blank="-"}}
      </select>
    </div>
    <div class="grid-span-1 property">
      <select class="property--value" name="system.rank" {{disabled (not isEdit)}}>
        {{selectOptions config.ranks selected=system.rank blank="-"}}
      </select>
    </div>
    <div class="grid-span-5 property">
      <label class="property--label" for="{{docId}}system.price">{{localize "SW25.Item.Price"}}</label>
      <input class="property--value" id="{{docId}}system.price" type="text"
             name="system.price" value="{{system.price}}" data-dtype="Number" {{disabled (not isEdit)}}/>
    </div>

    <div class="grid-span-3 property">
      <input class="checkbox--hidden" id="{{docId}}system.isMagicitem" type="checkbox"
             name="system.isMagicitem" data-dtype="Boolean" {{checked system.isMagicitem}} {{disabled (not isEdit)}}/>
      <label class="checkbox--label" for="{{docId}}system.isMagicitem">{{localize "SW25.Item.MagicItem"}}</label>
    </div>
    <div class="grid-span-3 property">
      <input class="checkbox--hidden" id="{{docId}}system.isHonoritem" type="checkbox"
             name="system.isHonoritem" data-dtype="Boolean" {{checked system.isHonoritem}} {{disabled (not isEdit)}}/>
      <label class="checkbox--label" for="{{docId}}system.isHonoritem">{{localize "SW25.Item.HonorItem"}}</label>
    </div>
    <div class="grid-span-4 property">
      <label class="property--label" for="{{docId}}system.honor">{{localize "SW25.Item.Honor"}}</label>
      <input class="property--value" id="{{docId}}system.honor" type="text"
             name="system.honor" value="{{system.honor}}" data-dtype="Number" {{disabled (not isEdit)}}/>
    </div>

    <div class="grid-span-1 property-col">
      <label class="property--label-col" for="{{docId}}system.info.popularity">{{localize "SW25.Item.Popularity"}}</label>
      <input class="property--value" id="{{docId}}system.info.popularity" type="number"
             name="system.info.popularity" value="{{system.info.popularity}}" data-dtype="String" {{disabled (not isEdit)}}/>
    </div>
    <div class="grid-span-7 property-col">
      <label class="property--label-col" for="{{docId}}system.info.shape">{{localize "SW25.Item.Shape"}}</label>
      <input class="property--value" id="{{docId}}system.info.shape" type="text"
             name="system.info.shape" value="{{system.info.shape}}" data-dtype="String" {{disabled (not isEdit)}}/>
    </div>
    <div class="grid-span-2 property-col">
      <label class="property--label-col" for="{{docId}}system.info.create">{{localize "SW25.Item.Create"}}</label>
      <input class="property--value" id="{{docId}}system.info.create" type="text"
             name="system.info.create" value="{{system.info.create}}" data-dtype="String" {{disabled (not isEdit)}}/>
    </div>

    <div class="grid-span-2 property-col">
      <label class="property--label-col" for="{{docId}}system.type">{{localize "SW25.Item.Weapon.Type"}}</label>
      <select class="property--value" id="{{docId}}system.type" name="system.type" {{disabled (not isEdit)}}>
        {{selectOptions config.weaponTypes selected=system.type localize=true blank="-"}}
      </select>
    </div>
    <div class="grid-span-2 property-col">
      <label class="property--label-col" for="{{docId}}system.usage">{{localize "SW25.Item.Weapon.Usage"}}</label>
      <select class="property--value" id="{{docId}}system.usage" name="system.usage" {{disabled (not isEdit)}}>
        {{selectOptions config.weaponUsages selected=system.usage localize=true blank="-"}}
      </select>
    </div>
    <div class="grid-span-1 property-col">
      <label class="property--label-col" for="{{docId}}system.reqstr">{{localize "SW25.Item.Reqstr"}}</label>
      <input class="property--value" id="{{docId}}system.reqstr" type="text"
             name="system.reqstr" value="{{system.reqstr}}" data-dtype="Number" {{disabled (not isEdit)}}/>
    </div>
    <div class="grid-span-1 property-col">
      <label class="property--label-col" for="{{docId}}system.hit">{{localize "SW25.Item.Weapon.Hit"}}</label>
      <input class="property--value" id="{{docId}}system.hit" type="text"
             name="system.hit" value="{{system.hit}}" data-dtype="Number" {{disabled (not isEdit)}}/>
    </div>
    <div class="grid-span-1 property-col">
      <label class="property--label-col" for="{{docId}}system.dmod">{{localize "SW25.Item.Weapon.Dmod"}}</label>
      <input class="property--value" id="{{docId}}system.dmod" type="text"
             name="system.dmod" value="{{system.dmod}}" data-dtype="Number" {{disabled (not isEdit)}}/>
    </div>
    <div class="grid-span-3 property-col">
      <label class="property--label-col" for="{{docId}}system.range">{{localize "SW25.Item.Weapon.Range"}}</label>
      <input class="property--value" id="{{docId}}system.range" type="text"
             name="system.range" value="{{system.range}}" data-dtype="String" {{disabled (not isEdit)}}/>
    </div>

    {{!-- Elements Category --}}
    <div class="grid-span-10">
      {{> "systems/sw25/templates/item/parts/item-elements.hbs" isMagic=true isPhysical=true}}
    </div>

    {{!-- Resource Category --}}
    <fieldset class="subcategory flexrow grid grid-10col">
      <legend class="category__title">{{localize "SW25.Item.Field.Resource"}}</legend>
      <div class="grid-span-2 property">
        <label class="property--label" for="{{docId}}system.basehpcost">HP{{localize "SW25.Cost"}}</label>
        <input class="property--value" id="{{docId}}system.basehpcost" type="text"
               name="system.basehpcost" value="{{system.basehpcost}}" data-dtype="String" {{disabled (not isEdit)}}/>
      </div>
      <div class="grid-span-1 property">
        <input class="property--value" id="{{docId}}system.maxhpcost" type="text"
               name="system.maxhpcost" value="{{system.maxhpcost}}" data-dtype="Number"
               placeholder="{{localize "SW25.Max"}}" {{disabled (not isEdit)}}/>
      </div>
      <div class="grid-span-2 property">
        <label class="property--label" for="{{docId}}system.basempcost">MP{{localize "SW25.Cost"}}</label>
        <input class="property--value" id="{{docId}}system.basempcost" style="max-width: calc(50% - 7px);"
               type="text" name="system.basempcost" value="{{system.basempcost}}" data-dtype="Number" {{disabled (not isEdit)}}/>
      </div>
      <div class="grid-span-5"></div>
      <div class="grid-span-7 property">
        <label class="property--label">{{localize "SW25.Item.Resuse"}}</label>
        <select class="property--value" name="system.resuse" {{disabled (not isEdit)}}>
          {{selectOptions system.itemlist selected=system.resuse valueAttr="itemId" labelAttr="itemName" blank="SW25.Item.None" localize=true}}
        </select>
      </div>
      <div class="grid-span-3 property">
        <input class="property--value" id="{{docId}}system.resusequantity" type="text"
               name="system.resusequantity" value="{{system.resusequantity}}" data-dtype="Number"
               placeholder="{{localize "SW25.Item.Resquantity"}}" {{disabled (not isEdit)}}/>
        <input class="checkbox--hidden" id="{{docId}}system.autouseres" type="checkbox"
               name="system.autouseres" data-dtype="Boolean" {{checked system.autouseres}} {{disabled (not isEdit)}}/>
        <label class="checkbox--label" for="{{docId}}system.autouseres">{{localize "SW25.Item.AutoUseres"}}</label>
      </div>
    </fieldset>
  </fieldset>

  {{!-- Use-dice Category --}}
  <fieldset class="category">
    <legend class="category__title">
      <input class="checkbox--hidden" id="{{docId}}system.usedice" type="checkbox"
             name="system.usedice" data-dtype="Boolean" {{checked system.usedice}} {{disabled (not isEdit)}}/>
      <label class="checkbox--label" for="{{docId}}system.usedice">{{localize "SW25.Item.Usedice"}}</label>
    </legend>
    <div style="display: {{#if system.usedice}}block{{else}}none{{/if}};">
      {{> "systems/sw25/templates/item/parts/item-usedice.hbs"}}
    </div>
  </fieldset>

  {{!-- Use-power Category --}}
  <fieldset class="category">
    <legend class="category__title">
      <input class="checkbox--hidden" id="{{docId}}system.usepower" type="checkbox"
             name="system.usepower" data-dtype="Boolean" {{checked system.usepower}} {{disabled (not isEdit)}}/>
      <label class="checkbox--label" for="{{docId}}system.usepower">{{localize "SW25.Item.Usepower"}}</label>
    </legend>
    <div style="display: {{#if system.usepower}}block{{else}}none{{/if}};">
      {{> "systems/sw25/templates/item/parts/item-usepower.hbs"}}
    </div>
  </fieldset>
</section>
