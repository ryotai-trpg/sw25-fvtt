{{!-- check の詳細タブ。

     威力表のブロックは V1 と同じく inline の display で出し入れする。
     `{{#if}}` で消すと入力がフォームから抜けるので、
     挙動を変えないためこのままにしている。
     lethaltech / criticalray に isEdit の縛りが無いのも V1 のまま。 --}}
<section class="tab {{tab.id}} {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

  {{!-- Basic Category --}}
  <fieldset class="category flexrow grid grid-10col">
    <legend class="category__title">{{localize "SW25.Item.Field.Basic"}}</legend>
    <div class="grid-span-10 property">
      <label class="property--label" for="{{docId}}system.overview">{{localize "SW25.Item.Overview"}}</label>
      <input class="property--value" id="{{docId}}system.overview" type="text"
             name="system.overview" value="{{system.overview}}" data-dtype="String" {{disabled (not isEdit)}}/>
    </div>
  </fieldset>

  {{!-- Check Category --}}
  <fieldset class="category flexrow grid grid-10col">
    <legend class="category__title">{{localize "SW25.Item.Field.Check"}}</legend>

    <div class="grid-span-3 property">
      <select class="property--value" id="{{docId}}system.checkmethod"
              name="system.checkmethod" {{disabled (not isEdit)}}>
        {{selectOptions checkmethodOptions selected=system.checkmethod localize=true}}
      </select>
    </div>
    <div class="grid-span-3 property">
      <label class="property--label">{{localize "SW25.Item.Check.Package"}}</label>
      <select class="property--value" name="system.checkpackage" {{disabled (not isEdit)}}>
        {{selectOptions config.checkpackages selected=system.checkpackage localize=true blank=""}}
      </select>
    </div>
    <div class="grid-span-2 property">
      <input class="checkbox--hidden" id="{{docId}}system.showbtcheck" type="checkbox"
             name="system.showbtcheck" data-dtype="Boolean" {{checked system.showbtcheck}} {{disabled (not isEdit)}}/>
      <label class="checkbox--label" for="{{docId}}system.showbtcheck">{{localize "SW25.Battle"}}</label>
    </div>
    <div class="grid-span-2 blank"></div>

    <div class="grid-span-3 property-col">
      <label class="property--label-col">{{localize "SW25.Skillname"}}</label>
      <select class="property--value" name="system.checkskill" {{disabled (not isEdit)}}>
        <option value="">-</option>
        <option value="adv" {{#if (eq system.checkskill "adv")}}selected{{/if}}>{{localize "SW25.Attributes.Advlevel"}}</option>
        {{selectOptions system.skilllist selected=system.checkskill valueAttr="name" labelAttr="name"}}
      </select>
    </div>
    <div class="grid-span-2 property-col">
      <label class="property--label-col">{{localize "SW25.Abilityname"}}</label>
      <select class="property--value" name="system.checkabi" {{disabled (not isEdit)}}>
        {{selectOptions config.abilities selected=system.checkabi localize=true blank="-"}}
      </select>
    </div>
    <div class="grid-span-1 property-col">
      <label class="property--label-col" for="{{docId}}system.checkmod">{{localize "SW25.Modifier"}}</label>
      <input class="property--value" id="{{docId}}system.checkmod" type="text"
             name="system.checkmod" value="{{system.checkmod}}" data-dtype="Number" {{disabled (not isEdit)}}/>
    </div>
    {{#if (eq system.checkmethod "dice")}}
      <div class="grid-span-4 property-col">
        <label class="property--label-col" for="{{docId}}system.customformula">{{localize "SW25.Item.Formula"}}</label>
        <input class="property--value" id="{{docId}}system.customformula" type="text"
               name="system.customformula" value="{{system.customformula}}" data-dtype="String" {{disabled (not isEdit)}}/>
      </div>
    {{else}}
      <div class="grid-span-4 blank"></div>
    {{/if}}

    {{#unless (eq system.checkmethod "power")}}
      <div class="grid-span-2 property">
        <select class="property--value" name="system.applycheck" {{disabled (not isEdit)}}>
          {{selectOptions applyOptions selected=system.applycheck localize=true}}
        </select>
      </div>
      <div class="grid-span-8 property">
        {{#if (eq system.applycheck "custom")}}
          {{#each checkDamageButtons as |btn|}}
            <label for="{{btn.id}}">
              <input id="{{btn.id}}" type="checkbox" class="small-checkbox" name="{{btn.name}}"
                     data-dtype="Boolean" {{checked btn.value}} {{disabled (not ../isEdit)}}/>{{btn.label}}
            </label>
          {{/each}}
        {{/if}}
      </div>
    {{/unless}}

    <div class="grid-span-10" style="display: {{#if (eq system.checkmethod "power")}}block{{else}}none{{/if}};">
      <div class="flexrow grid grid-8col">
        <span class="resource-label grid-span-2" style="text-decoration: underline;">{{localize "SW25.Item.Powertable"}}{{localize "SW25.Setting"}}</span>
        <span class="grid-span-6" style="text-align: left;">
          <select name="system.applypower" {{disabled (not isEdit)}}>
            {{selectOptions applyOptions selected=system.applypower localize=true}}
          </select>
          {{#if (eq system.applypower "custom")}}
            {{#each powerDamageButtons as |btn|}}
              <label for="{{btn.id}}">
                <input id="{{btn.id}}" type="checkbox" class="small-checkbox" name="{{btn.name}}"
                       data-dtype="Boolean" {{checked btn.value}} {{disabled (not ../isEdit)}}/>{{btn.label}}
              </label>
            {{/each}}
          {{/if}}
        </span>
      </div>

      <div class="flexrow grid grid-8col">
        <span style="text-align: center;">
          <label for="{{docId}}system.power"><b>{{localize "SW25.Item.Power"}}</b></label><br>
          <input id="{{docId}}system.power" type="text" name="system.power"
                 value="{{system.power}}" data-dtype="Number" {{disabled (not isEdit)}}/>
        </span>
        <span style="text-align: center;">
          <label for="{{docId}}system.cvalue"><b>{{localize "SW25.Item.Cvalue"}}</b></label><br>
          <input id="{{docId}}system.cvalue" type="text" name="system.cvalue"
                 value="{{system.cvalue}}" data-dtype="Number" {{disabled (not isEdit)}}/>
        </span>
        <span style="text-align: center;">
          <label for="{{docId}}system.halfpow"><b>{{localize "SW25.Item.Halfpow"}}</b></label><br>
          <input id="{{docId}}system.halfpow" type="checkbox" name="system.halfpow"
                 data-dtype="Boolean" {{checked system.halfpow}} {{disabled (not isEdit)}}/>
        </span>
        <div class="grid-span-3"></div>
        <span class="grid-span-2" style="text-align: center;">
          <label for="{{docId}}system.showpowmod"><b>{{localize "SW25.Item.Particularmod"}}</b></label><br>
          <input id="{{docId}}system.showpowmod" type="checkbox" name="system.showpowmod"
                 data-dtype="Boolean" {{checked system.showpowmod}} {{disabled (not isEdit)}}/>
        </span>
      </div>

      <div class="grid-powertable">
        {{#each powerTableRows as |row|}}
          <label class="pt-item pt-label" for="{{row.id}}">{{row.roll}}</label>
        {{/each}}
        {{#each powerTableRows as |row|}}
          <div class="pt-item">
            <input type="text" id="{{row.id}}" name="{{row.name}}" value="{{row.value}}"
                   data-dtype="Number" {{disabled (not ../isEdit)}}/>
          </div>
        {{/each}}
      </div>

      <div style="display: {{#if system.showpowmod}}block{{else}}none{{/if}};">
        <div class="flexcol">
          <div class="flexrow grid grid-10col">
            <label for="{{docId}}system.halfpowmod" class="grid-span-2" style="text-align: center;">
              <b>{{localize "SW25.Item.Halfpowmod"}}</b><br>
              <input id="{{docId}}system.halfpowmod" style="max-width: calc(50% - 7px);" type="text"
                     name="system.halfpowmod" value="{{system.halfpowmod}}" data-dtype="Number" {{disabled (not isEdit)}}/>
            </label>
            {{!-- lethaltech / criticalray は V1 でも isEdit で縛られていない --}}
            <label for="{{docId}}system.lethaltech" class="grid-span-2" style="text-align: center;">
              <b>{{localize "SW25.Item.Lethaltech"}}</b><br>
              <input id="{{docId}}system.lethaltech" style="max-width: calc(50% - 7px);" type="text"
                     name="system.lethaltech" value="{{system.lethaltech}}" data-dtype="Number"/>
            </label>
            <label for="{{docId}}system.criticalray" class="grid-span-2" style="text-align: center;">
              <b>{{localize "SW25.Item.Criticalray"}}</b><br>
              <input id="{{docId}}system.criticalray" style="max-width: calc(50% - 7px);" type="text"
                     name="system.criticalray" value="{{system.criticalray}}" data-dtype="String"/>
            </label>
            <label for="{{docId}}system.pharmtool" class="grid-span-2" style="text-align: center;">
              <b>{{localize "SW25.Item.Pharmtool"}}</b><br>
              <input id="{{docId}}system.pharmtool" style="max-width: calc(50% - 7px);" type="text"
                     name="system.pharmtool" value="{{system.pharmtool}}" data-dtype="Number" {{disabled (not isEdit)}}/>
            </label>
            <label for="{{docId}}system.powup" class="grid-span-2" style="text-align: center;">
              <b>{{localize "SW25.Item.Powup"}}</b><br>
              <input id="{{docId}}system.powup" style="max-width: calc(50% - 7px);" type="text"
                     name="system.powup" value="{{system.powup}}" data-dtype="Number" {{disabled (not isEdit)}}/>
            </label>
          </div>
          <div>
            {{localize "SW25.Item.Cwarn"}}<br>
            {{localize "SW25.Item.halfwarn"}}<br>
            {{localize "SW25.Item.Nullwarn"}}<br>
            {{localize "SW25.Item.Crwarn"}}<br>
            {{localize "SW25.Item.Pharmwarn"}}<br>
            {{localize "SW25.Item.Pharmwarn2"}}<br>
            {{localize "SW25.Item.Powupwarn"}}<br>
          </div>
        </div>
      </div>
    </div>

    {{> "systems/sw25/templates/item/parts/detail-resist.hbs" resist=resistInfo}}
  </fieldset>
</section>
