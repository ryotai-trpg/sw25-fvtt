{{!-- monsterability のヘッダ固有部分。

     判定ブロックごとのラベルを並べ、概要は `system.remark`(他の型と違う)。
     右肩は起動だけで、ブックマークは持たない。 --}}
<section class="header__subtitle">
  <span class="header__subtitle--label">
    {{#if system.usedice1}}{{system.label1}}{{/if}}
    {{#if system.usedice2}}{{system.label2}}{{/if}}
    {{#if system.usedice3}}{{system.label3}}{{/if}}
    {{#if system.usepower}}{{system.labelmonpow}}{{/if}}
  </span>
  <div class="header__subtitle--overview">{{system.remark}}</div>
</section>

<section class="header__activate">
  <div class="header__checkbox">
    <input class="checkbox--hidden" id="{{docId}}system.equip" type="checkbox"
           name="system.equip" data-dtype="Boolean" {{checked system.equip}}/>
    <label class="checkbox--label" for="{{docId}}system.equip">{{localize "SW25.Item.Activation"}}</label>
  </div>
</section>
