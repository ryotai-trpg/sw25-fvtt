{{!-- language のヘッダ固有部分。ラベルはスキーマから引く
      (`SW25.Item.language.FIELDS.*` — LOCALIZATION_PREFIXES 経由で本体が翻訳済みにしている)。 --}}
<section class="header__subtitle">
  <div class="header__checkbox">
    <input class="checkbox--hidden" id="{{docId}}system.conversation" type="checkbox"
           name="system.conversation" data-dtype="Boolean" {{checked system.conversation}}/>
    <label class="checkbox--label" for="{{docId}}system.conversation">{{systemFields.conversation.label}}</label>

    <input class="checkbox--hidden" id="{{docId}}system.reading" type="checkbox"
           name="system.reading" data-dtype="Boolean" {{checked system.reading}}/>
    <label class="checkbox--label" for="{{docId}}system.reading">{{systemFields.reading.label}}</label>
  </div>
</section>

<section class="header__activate"></section>
