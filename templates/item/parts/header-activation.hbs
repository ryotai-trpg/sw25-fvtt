{{!-- ヘッダ右肩の起動 / ブックマーク。特技・呪文系 13 型が同じものを持つ。 --}}
<section class="header__activate">
  <div class="header__checkbox">
    <input class="checkbox--hidden" id="{{docId}}system.equip" type="checkbox"
           name="system.equip" data-dtype="Boolean" {{checked system.equip}}/>
    <label class="checkbox--label" for="{{docId}}system.equip">{{localize "SW25.Item.Activation"}}</label>
  </div>
  <div class="header__checkbox">
    <input class="checkbox--hidden" id="{{docId}}system.bookmark" type="checkbox"
           name="system.bookmark" data-dtype="Boolean" {{checked system.bookmark}}/>
    <label class="checkbox--label" for="{{docId}}system.bookmark">{{localize "SW25.Item.Bookmark"}}</label>
  </div>
</section>
