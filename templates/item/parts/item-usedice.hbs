<div class="flexrow grid grid-10col">
  <span class="resource-label grid-span-2" style="text-decoration: underline;">{{localize "SW25.Check"}}{{localize "SW25.Setting"}}</span>
  <span class="grid-span-2" style="text-align: left;">{{localize "SW25.Check"}}{{localize "SW25.Basenumber"}} : <b>{{system.checkbase}}</b></span>
  <span class="grid-span-2" style="text-align: left;">
    <select name="system.applycheck"{{#unless system.isEdit}} disabled{{/unless}}>
      {{selectOptions applyOptions selected=system.applycheck localize=true}}
    </select>
  </span>
  <span class="grid-span-4">
    {{#if (eq system.applycheck "custom")}}
    <div class="flexcol">
      <div>
        <label for="{{docId}}ckpdbt"><input id="{{docId}}ckpdbt" type="checkbox" class="small-checkbox" name="system.ckpdbt" data-dtype="Boolean" {{#if system.ckpdbt}} checked {{/if}}{{#unless system.isEdit}} disabled{{/unless}}/>{{localize "SW25.Item.pd"}}</label>
        <label for="{{docId}}ckmdbt"><input id="{{docId}}ckmdbt" type="checkbox" class="small-checkbox" name="system.ckmdbt" data-dtype="Boolean" {{#if system.ckmdbt}} checked {{/if}}{{#unless system.isEdit}} disabled{{/unless}}/>{{localize "SW25.Item.md"}}</label>
        <label for="{{docId}}ckcdbt"><input id="{{docId}}ckcdbt" type="checkbox" class="small-checkbox" name="system.ckcdbt" data-dtype="Boolean" {{#if system.ckcdbt}} checked {{/if}}{{#unless system.isEdit}} disabled{{/unless}}/>{{localize "SW25.Item.cd"}}</label>
      </div>
      <div>
        <label for="{{docId}}ckhrbt"><input id="{{docId}}ckhrbt" type="checkbox" class="small-checkbox" name="system.ckhrbt" data-dtype="Boolean" {{#if system.ckhrbt}} checked {{/if}}{{#unless system.isEdit}} disabled{{/unless}}/>{{localize "SW25.Item.hr"}}</label>
        <label for="{{docId}}ckmrbt"><input id="{{docId}}ckmrbt" type="checkbox" class="small-checkbox" name="system.ckmrbt" data-dtype="Boolean" {{#if system.ckmrbt}} checked {{/if}}{{#unless system.isEdit}} disabled{{/unless}}/>{{localize "SW25.Item.mr"}}</label>
      </div>
    </div>
    {{/if}}
  </span>
</div>
<div class="flexrow grid grid-8col">
  <span class="grid-span-2" style="text-align: center;"><b>{{localize "SW25.Check"}}{{localize "SW25.Skillname"}}</b><br>
    <select name="system.checkskill"{{#unless system.isEdit}} disabled{{/unless}}>
      <option value="">-</option>
      <option value="adv" {{#if (eq system.checkskill "adv")}}selected{{/if}}>{{localize "SW25.Attributes.Advlevel"}}</option>
      {{#if system.skilllist}}
      {{selectOptions system.skilllist selected=system.checkskill valueAttr="name" labelAttr="name"}}
      {{/if}}
    </select>
  </span>
  <span class="grid-span-2" style="text-align: center;"><b>{{localize "SW25.Check"}}{{localize "SW25.Abilityname"}}</b><br>
    <select name="system.checkabi"{{#unless system.isEdit}} disabled{{/unless}}>
      {{selectOptions config.abilities selected=system.checkabi localize=true blank="-"}}
    </select>
  </span>
  <span class="grid-span-2" style="text-align: center;"><label for="{{docId}}system.checkmod"><b>{{localize "SW25.Check"}}{{localize "SW25.Modifier"}}</b></label><br>
    <input id="{{docId}}system.checkmod" style="max-width: calc(50% - 7px);" type="text" name="system.checkmod" value="{{system.checkmod}}" data-dtype="Number"/></span>
</div>
<div class="flexcol grid grid-8col nogapmargin">
  <div class="grid-span-2 flex-group-center">
    <span style="text-align: center;"><label for="{{docId}}system.customdice"><b>{{localize "SW25.Item.Customdice"}}</b></label><br>
      <input id="{{docId}}system.customdice" type="checkbox" name="system.customdice" data-dtype="Boolean" {{#if system.customdice}} checked {{/if}}{{#unless system.isEdit}} disabled{{/unless}}/></span>
  </div>
  <div class="grid-span-4" style="display: {{#if system.customdice}}block{{else}}none{{/if}};">
    <label for="{{docId}}customformula" class="resource-label">{{localize "SW25.Item.Formula"}}</label>
    <input id="{{docId}}customformula" type="text" name="system.customformula" value="{{system.customformula}}" data-dtype="String"{{#unless system.isEdit}} disabled{{/unless}}/>
  </div>
  <div class="grid-span-2">
  </div>
</div>
