{{!-- barbarousskill の説明タブ。概要カードに fa アイコンや条件付きの並びが
     入るので、共通の description.hbs(overviewCards)には畳まず
     マークアップのまま持つ。 --}}
<section class="tab {{tab.id}} {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

      <div class="grid grid-6col flex-group-left">
        <div class="grid-span-2 overview">
          <div class="overview--label">
            {{localize "SW25.Item.BarbarousSkill.Base"}}
          </div>
          <div class="overview--value">
            {{localizeStatus system.checkabi}}
          </div>
        </div>
        <div class="grid-span-2 overview">
          <div class="overview--label">
            {{localize "SW25.Item.BarbarousSkill.ResistBase"}}
          </div>
          <div class="overview--value">
            {{localizeResistType system.resistinfo.type system.resistinfo.input}}
          </div>
        </div>
        <div class="grid-span-2 overview">
          <div class="overview--label">
            {{localize "SW25.Item.Resist"}}
          </div>
          <div class="overview--value">
            {{localizeResist system.resistinfo.result}}
          </div>
        </div>
        <div class="grid-span-6 overview">
          <div class="overview--label">
            {{localize "SW25.Item.Overview"}}
          </div>
          <div class="overview--value">
            {{system.overview}}
          </div>
        </div>
      </div>
      {{> "systems/sw25/templates/item/parts/editor.hbs"}}
</section>
