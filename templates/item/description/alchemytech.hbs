{{!-- alchemytech の説明タブ。概要カードに fa アイコンや条件付きの並びが
     入るので、共通の description.hbs(overviewCards)には畳まず
     マークアップのまま持つ。 --}}
<section class="tab {{tab.id}} {{tab.cssClass}}" data-group="{{tab.group}}" data-tab="{{tab.id}}">

      <div class="grid grid-6col flex-group-left">
        <div class="grid-span-3 overview">
          <div class="overview--label">
            {{localize "SW25.Target"}}
          </div>
          <div class="overview--value">
            {{system.target}}
          </div>
        </div>
        <div class="grid-span-3 overview">
          <div class="overview--label">
            {{localize "SW25.Rangeshape"}}
          </div>
          <div class="overview--value">
            {{system.rangeshape}}
          </div>
        </div>
        <div class="grid-span-2 overview">
          <div class="overview--label">
            {{localize "SW25.Time"}}
          </div>
          <div class="overview--value">
            {{system.time}}
          </div>
        </div>
        <div class="grid-span-2 overview">
          <div class="overview--label">
            {{localize "SW25.Item.Resist"}}
          </div>
          <div class="overview--value">
            {{localizeResist system.resistinfo.result}}
          </div>
        </div>
        <div class="grid-span-2 overview">
          <div class="overview--label">
            {{localize "SW25.Cost"}}
          </div>
          <div class="overview--value">
            {{#unless (eq system.red 0)}} {{localize "SW25.Item.Alchemytech.Red"}}{{system.red}}{{/unless}}
            {{#unless (eq system.green 0)}} {{localize "SW25.Item.Alchemytech.Green"}}{{system.green}}{{/unless}}
            {{#unless (eq system.black 0)}} {{localize "SW25.Item.Alchemytech.Black"}}{{system.black}}{{/unless}}
            {{#unless (eq system.white 0)}} {{localize "SW25.Item.Alchemytech.White"}}{{system.white}}{{/unless}}
            {{#unless (eq system.gold 0)}} {{localize "SW25.Item.Alchemytech.Gold"}}{{system.gold}}{{/unless}}
          </div>
        </div>
        <div class="grid-span-6 overview">
          <div class="overview--label">
            {{localize "SW25.Item.Overview"}}
          </div>
          <div class="overview--value">
            {{system.overview}}
          </div>
        </div>
      </div>
      {{> "systems/sw25/templates/item/parts/editor.hbs"}}
</section>
