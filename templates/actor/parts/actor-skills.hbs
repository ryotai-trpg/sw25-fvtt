<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "SW25.Skillname"}}</div>
    <div class='item-skilllevel' style="flex: 0 0 60px;">{{localize "SW25.Item.Skill.Skilllevel"}}</div>
    {{> "systems/sw25/templates/actor/parts/actor-item-create.hbs" type="skill"}}
  </li>
  {{#each skills as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        {{> "systems/sw25/templates/actor/parts/actor-item-rowhead.hbs" item=item nomarks=true}}
        <div class='item-skilllevel item-prop input flexrow flex-group-center' style="flex: 0 0 60px;">
{{!--
          <a class="changesl-button" data-action="decrease" data-property="item.system.skilllevel">
            <i class="fas fa-minus"></i>
          </a>
--}}
          <input class="sl-change" type="text" name="skilllevelInput" value="{{item.system.skilllevel}}" data-dtype="Number"/>
{{!--
          <a class="changesl-button" data-action="increase" data-property="item.system.skilllevel">
            <i class="fas fa-plus"></i>
          </a>
--}}
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-item-controls.hbs" type="skill" mode="always" viewLabel="DOCUMENT.Update" isOwner=../isOwner isEdit=../system.isEdit}}
      </div>
      {{> "systems/sw25/templates/actor/parts/actor-item-description.hbs"}}
    </li>
  {{/each}}
</ol>
