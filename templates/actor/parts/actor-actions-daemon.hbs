<ol class='items-list'>
  <div class='item flexrow items-header'>
    <div class='item-element' style="flex: 0 0 60px;">{{localize "SW25.Item.Dice"}}</div>
    <div class='item-element' style="flex: 0 0 60px;">{{localize "SW25.Item.Action.ActionResult"}}</div>
    <div class='item-element' style="flex: 0 0 120px;">{{localize "SW25.Item.Action.Label"}}</div>
    <div class='item-name'>{{localize "TYPES.Item.action"}}</div>
    <div class='item-element' style="flex: 0 0 100px;">{{localize "SW25.Item.Action.Label"}}</div>
    <div class='item-element' style="flex: 0 0 60px; margin-right: 10px;">{{localize "SW25.Item.Action.ActionValue"}}</div>
  </div>
  <div class="item flexrow">
    <div class="roll-actiontable rollable" data-result="1" style="flex: 0 0 60px; font-size: 24px; text-align: center;">
      <i class="fas fa-dice-one"></i>
    </div>
    <div class="item flexcol" style="align-items: normal;">
      <div class="item flexrow actiontable" data-area="d18">
        <div style="flex: 0 0 60px; font-size: 16px; font-weight: bold; text-align: center;">8</div>
        <div class="item flexcol" style="align-items: normal;">
          {{#each actionsd18 as |item id|}}
            {{> "systems/sw25/templates/actor/parts/actor-action-row.hbs" item=item nameWidth="120px" showTarget=true isOwner=true isEdit=../system.isEdit}}
          {{/each}}
        </div>
      </div>
    </div>
  </div>
  <div class="item flexrow">
    <div class="roll-actiontable rollable" data-result="2" style="flex: 0 0 60px; font-size: 24px; text-align: center;">
      <i class="fas fa-dice-two"></i> <i class="fas fa-dice-three"></i>
    </div>
    <div class="item flexcol" style="align-items: normal;">
      <div class="item flexrow actiontable" data-area="d28">
        <div style="flex: 0 0 60px; font-size: 16px; font-weight: bold; text-align: center;">8</div>
        <div class="item flexcol" style="align-items: normal;">
          {{#each actionsd28 as |item id|}}
            {{> "systems/sw25/templates/actor/parts/actor-action-row.hbs" item=item nameWidth="120px" showTarget=true isOwner=true isEdit=../system.isEdit}}
          {{/each}}
        </div>
      </div>
    </div>
  </div>
  <div class="item flexrow">
    <div class="roll-actiontable rollable" data-result="4" style="flex: 0 0 60px; font-size: 24px; text-align: center;">
      <i class="fas fa-dice-four"></i> <i class="fas fa-dice-five"></i>
    </div>
    <div class="item flexcol" style="align-items: normal;">
      <div class="item flexrow actiontable" data-area="d49">
        <div style="flex: 0 0 60px; font-size: 16px; font-weight: bold; text-align: center;">9</div>
        <div class="item flexcol" style="align-items: normal;">
          {{#each actionsd49 as |item id|}}
            {{> "systems/sw25/templates/actor/parts/actor-action-row.hbs" item=item nameWidth="120px" showTarget=true isOwner=true isEdit=../system.isEdit}}
          {{/each}}
        </div>
      </div>
    </div>
  </div>
  <div class="item flexrow">
    <div class="roll-actiontable rollable" data-result="6" style="flex: 0 0 60px; font-size: 24px; text-align: center;">
      <i class="fas fa-dice-six"></i>
    </div>
    <div class="item flexcol" style="align-items: normal;">
      <div class="item flexrow actiontable" data-area="d610">
        <div style="flex: 0 0 60px; font-size: 16px; font-weight: bold; text-align: center;">10</div>
        <div class="item flexcol" style="align-items: normal;">
          {{#each actionsd610 as |item id|}}
            {{> "systems/sw25/templates/actor/parts/actor-action-row.hbs" item=item nameWidth="120px" showTarget=true isOwner=../isOwner isEdit=../system.isEdit}}
          {{/each}}
        </div>
      </div>
    </div>
  </div>
</ol>
