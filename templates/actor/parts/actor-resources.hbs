<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "SW25.Resource"}}</div>
    <div class='item-element'>{{localize "SW25.Quantity"}}</div>
    {{> "systems/sw25/templates/actor/parts/actor-item-create.hbs" type="resource"}}
  </li>
  {{#each resources as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        <div class='item-name' style="flex: 3;" data-tooltip="{{item.name}}"><h4 class="item-label">{{item.name}}</h4></div>
        {{> "systems/sw25/templates/actor/parts/actor-item-quantity.hbs" item=item style="flex-shrink:0; flex-basis: 40px;"}}
        {{#if ../isOwner}}
          {{#if ../system.isEdit}}
            <div class='item-controls'>
              <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.resource")}}'>
                <i class='fas fa-edit'></i>
              </a>
              <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.resource")}}'>
                <i class='fas fa-trash'></i>
              </a>
            </div>
          {{else}}
            <div class="item-equip">
              {{#if system.useequip}}
              <label class="equip-toggle">
                <input class="eq-change" type="checkbox" name="system.equip" data-dtype="Boolean" {{#if system.equip}} checked {{/if}}/>
              </label>
              {{/if}}
            </div>
          {{/if}}
        {{else}}
          <div class="item-equip">
            <a class='item-control item-edit' title='{{localize "DOCUMENT.View" type=(localize "TYPES.Item.resource")}}'>
              <i class='fa-solid fa-eye'></i>
            </a>
          </div>
        {{/if}}
      </div>
      {{> "systems/sw25/templates/actor/parts/actor-item-description.hbs"}}
    </li>
  {{/each}}
</ol>
