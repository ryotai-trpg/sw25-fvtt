<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "TYPES.Item.raceability"}}</div>
    <div class='item-element' style="flex: 0 0 30px;">HP</div>
    <div class='item-element' style="flex: 0 0 30px;">MP</div>
    <div class='item-element' style="flex: 0 0 60px;">{{localize "SW25.Item.Rest"}}</div>
    {{> "systems/sw25/templates/actor/parts/actor-item-create.hbs" type="raceability"}}
  </li>
  {{#each raceabilities as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        {{> "systems/sw25/templates/actor/parts/actor-item-rowhead.hbs" item=item}}
        {{> "systems/sw25/templates/actor/parts/actor-useitems.hbs" item=item}}
        <div class='hpcost item-prop flexrow flex-group-center' style="flex: 0 0 30px;" data-cost="{{item.system.hpcost}}" data-max="{{item.system.maxhpcost}}" data-label="{{item.name}}" data-type="{{item.type}}">
          {{system.hpcost}}
        </div>
        <div class='mpcost item-prop flexrow flex-group-center' style="flex: 0 0 30px;" data-cost="{{item.system.mpcost}}" data-label="{{item.name}}" data-type="{{item.type}}">
          {{system.mpcost}}
        </div>
        <div class='item-quantity item-prop flexrow flex-group-center' style="flex: 0 0 60px;">
          <a class="quantity-button" data-action="decrease" data-property="item.system.quantity">
            <i class="fas fa-minus"></i>
          </a>
          <input class="qt-change" type="text" name="quantityInput" value="{{item.system.quantity}}" data-dtype="Number"/>
          <a class="quantity-button" data-action="increase" data-property="item.system.quantity">
            <i class="fas fa-plus"></i>
          </a>
        </div>
        {{#if ../isOwner}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize "TYPES.Item.raceability")}}'>
              <i class='fas fa-edit'></i>
            </a>
            {{#if ../system.isEdit}}
              <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize "TYPES.Item.raceability")}}'>
                <i class='fas fa-trash'></i>
              </a>
            {{else}}
              <div class="item-equip">
                {{#if system.useequip}}
                <label class="equip-toggle">
                  <input class="eq-change" type="checkbox" name="system.equip" data-dtype="Boolean" {{#if system.equip}} checked {{/if}}/>
                </label>
                {{/if}}
              </div>
            {{/if}}
          </div>
        {{else}}
          <div class='item-controls'>
            <a class='item-control item-edit' title='{{localize "DOCUMENT.View" type=(localize "TYPES.Item.raceability")}}'>
              <i class='fa-solid fa-eye'></i>
            </a>
            <div class="item-equip">
              {{#if system.useequip}}
              <label class="equip-toggle">
                <input class="eq-change" type="checkbox" name="system.equip" data-dtype="Boolean" {{#if system.equip}} checked {{/if}}/>
              </label>
              {{/if}}
            </div>
          </div>
        {{/if}}
      </div>
      {{> "systems/sw25/templates/actor/parts/actor-item-description.hbs"}}
    </li>
  {{/each}}
</ol>
