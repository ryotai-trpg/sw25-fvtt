<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "TYPES.Item.item"}}</div>
    <div class='item-element' style="flex: 0 0 60px;">{{localize "SW25.Quantity"}}</div>
    {{> "systems/sw25/templates/actor/parts/actor-item-create.hbs" type="item"}}
  </li>
  {{#each gear as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        {{> "systems/sw25/templates/actor/parts/actor-item-rowhead.hbs" item=item nomarks=true}}
        {{> "systems/sw25/templates/actor/parts/actor-useitems.hbs" item=item}}
        {{> "systems/sw25/templates/actor/parts/actor-item-quantity.hbs" item=item style="flex: 0 0 60px;"}}
        {{> "systems/sw25/templates/actor/parts/actor-item-controls.hbs" type="item" mode="isEdit" isOwner=../isOwner isEdit=../system.isEdit}}
      </div>
      {{> "systems/sw25/templates/actor/parts/actor-item-description.hbs"}}
    </li>
  {{/each}}
</ol>
