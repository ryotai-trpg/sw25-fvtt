<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-element' style="flex: 0 0 30px;">{{localize "SW25.Item.Equip"}}</div>
    <div class='item-name'>{{localize "TYPES.Item.weapon"}}</div>
    <div class='item-element' style="flex: 1 0 0;">{{localize "SW25.Item.Category"}}</div>
    <div class='item-element' style="flex: 1 0 0;">{{localize "SW25.Item.Weapon.Usage"}}</div>
    <div class='item-element' style="flex: 0 0 50px;">{{localize "SW25.Item.Reqstr"}}</div>
    <div class='item-element' style="flex: 0 0 60px;">{{localize "SW25.Quantity"}}</div>
    {{> "systems/sw25/templates/actor/parts/actor-item-create.hbs" type="weapon"}}
  </li>
  {{#each weapons as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        <div class="item-equip">
          <label class="equip-toggle">
            <input class="eq-change" type="checkbox" name="system.equip" data-dtype="Boolean" {{#if system.equip}} checked {{/if}}/>
          </label>
        </div>
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item'>
              <img class="roll-icon" src='{{item.img}}' title='{{item.name}}'/>
            </a>
          </div>
          <h4 class="item-label">{{item.name}}{{#if item.system.dedicated}} ({{localize "SW25.Item.Dedicated"}}){{/if}}</h4>
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-useitems.hbs" item=item}}
        <div class='item-prop flexrow flex-group-center' style="flex: 1 0 0;">
          {{item.system.categoryname}}{{item.system.rank}}
        </div>
        <div class='item-prop flexrow flex-group-center' style="flex: 1 0 0;">
          {{#if item.system.usagename}}{{item.system.usagename}}({{item.system.typename}}){{/if}}
        </div>
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 50px;">
          {{item.system.reqstr}}
        </div>
        <div class='item-quantity item-prop flexrow flex-group-center' style="flex: 0 0 60px;">
          <a class="quantity-button" data-action="decrease" data-property="item.system.quantity">
            <i class="fas fa-minus"></i>
          </a>
          <input class="qt-change" type="text" name="quantityInput" value="{{item.system.quantity}}" data-dtype="Number"/>
          <a class="quantity-button" data-action="increase" data-property="item.system.quantity">
            <i class="fas fa-plus"></i>
          </a>
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-item-controls.hbs" type="weapon" mode="isEdit" viewLabel="DOCUMENT.Update" isOwner=../isOwner isEdit=../system.isEdit}}
      </div>
      {{> "systems/sw25/templates/actor/parts/actor-item-description.hbs"}}
    </li>
  {{/each}}
</ol>
