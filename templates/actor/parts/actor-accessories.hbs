<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-element' style="flex: 0 0 30px;">{{localize "SW25.Item.Equip"}}</div>
    <div class='item-name'>{{localize "TYPES.Item.accessory"}}</div>
    <div class='item-element' style="flex: 0 0 80px;">{{localize "SW25.Item.Accessory.Part"}}</div>
    <div class='item-element' style="flex: 0 0 60px;">{{localize "SW25.Quantity"}}</div>
    {{> "systems/sw25/templates/actor/parts/actor-item-create.hbs" type="accessory"}}
  </li>
  {{#each accessories as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        <div class="item-equip">
          <label class="equip-toggle">
            <input class="eq-change" type="checkbox" name="system.equip" data-dtype="Boolean" {{#if system.equip}} checked {{/if}}/>
          </label>
        </div>
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item'>
              <img class="roll-icon" src='{{item.img}}' title='{{item.name}}'/>
            </a>
          </div>
          <h4 class="item-label">{{item.name}}</h4>{{#if item.system.dedicated}} ({{localize "SW25.Item.Dedicated"}}{{item.system.deffectname}}){{/if}}
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-useitems.hbs" item=item}}
        <div style="text-align: center; flex: 0 0 80px;">
          {{item.system.accpartname}}
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-item-quantity.hbs" item=item style="flex: 0 0 60px;"}}
        {{> "systems/sw25/templates/actor/parts/actor-item-controls.hbs" type="accessory" mode="isEdit" isOwner=../isOwner isEdit=../system.isEdit}}
      </div>
      {{> "systems/sw25/templates/actor/parts/actor-item-description.hbs"}}
    </li>
  {{/each}}
</ol>
