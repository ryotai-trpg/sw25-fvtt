<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "TYPES.Item.barbarousskill"}}</div>
    <div class='item-element' style="flex: 0 0 50px;">{{localize "SW25.Item.Rank"}}</div>
    <div class='item-element' style="flex: 0 0 60px;">{{localize "SW25.Item.Resist"}}</div>
    <div class='item-element' style="flex: 0 0 100px;">{{localize "SW25.Item.BarbarousSkill.ResistBase"}}</div>
    <div class='item-element' style="flex: 0 0 30px;">HP</div>
    <div class='item-element' style="flex: 0 0 30px;">MP</div>
    {{> "systems/sw25/templates/actor/parts/actor-item-create.hbs" type="barbarousskill"}}
  </li>
  {{#each barbarousskill as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        {{> "systems/sw25/templates/actor/parts/actor-item-rowhead.hbs" item=item}}
        {{> "systems/sw25/templates/actor/parts/actor-useitems.hbs" item=item}}
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 50px;">
          {{system.rank}} 
        </div>
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 60px;">
          {{system.resistname}} 
        </div>
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 100px;">
          {{system.resistbase}} 
        </div>
        <div class='hpcost item-prop flexrow flex-group-center' style="flex: 0 0 30px;" data-cost="{{item.system.hpcost}}" data-max="{{item.system.maxhpcost}}" data-label="{{item.name}}" data-type="{{item.type}}">
          {{system.hpcost}}
        </div>
        <div class='mpcost item-prop flexrow flex-group-center' style="flex: 0 0 30px;" data-cost="{{item.system.mpcost}}" data-label="{{item.name}}" data-type="{{item.type}}">
          {{system.mpcost}}
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-item-controls.hbs" type="barbarousskill" mode="equip" isOwner=../isOwner isEdit=../system.isEdit}}
      </div>
      {{> "systems/sw25/templates/actor/parts/actor-item-description.hbs"}}
    </li>
  {{/each}}
</ol>
