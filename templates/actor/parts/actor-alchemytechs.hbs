<ol class='items-list'>
  {{#if materialshow.all}}
    <div class='item flexrow items-header'>
      <div class='item-name'>{{localize "TYPES.Item.alchemytech"}}</div>
    </div>
    <div class='item flexrow'>
      <div class='items-list materialcard'>
        <div class='item flexrow items-header spelllist-label'>
          <div class='resources'>{{localize "SW25.Item.Alchemytech.MaterialCard"}}</div>
          <div class='quantity'>B</div>
          <div class='quantity'>A</div>
          <div class='quantity'>S</div>
          <div class='quantity'>SS</div>
        </div>
        <div class="spelllist-description">
          {{#if materialshow.red}}
            {{> "systems/sw25/templates/actor/parts/actor-material-row.hbs" color="red" icon="fa-paw" label="SW25.Item.Alchemytech.Red" ranks=materials.red isOwner=isOwner isEdit=system.isEdit}}
          {{/if}}
          {{#if materialshow.green}}
            {{> "systems/sw25/templates/actor/parts/actor-material-row.hbs" color="green" icon="fa-leaf" label="SW25.Item.Alchemytech.Green" ranks=materials.green isOwner=isOwner isEdit=system.isEdit}}
          {{/if}}
          {{#if materialshow.black}}
            {{> "systems/sw25/templates/actor/parts/actor-material-row.hbs" color="black" icon="fa-gem" label="SW25.Item.Alchemytech.Black" ranks=materials.black isOwner=isOwner isEdit=system.isEdit}}
          {{/if}}
          {{#if materialshow.white}}
            {{> "systems/sw25/templates/actor/parts/actor-material-row.hbs" color="white" icon="fa-heart" label="SW25.Item.Alchemytech.White" ranks=materials.white isOwner=isOwner isEdit=system.isEdit}}
          {{/if}}
          {{#if materialshow.gold}}
            {{> "systems/sw25/templates/actor/parts/actor-material-row.hbs" color="gold" icon="fa-sun" label="SW25.Item.Alchemytech.Gold" ranks=materials.gold isOwner=isOwner isEdit=system.isEdit}}
          {{/if}}
        </div>
      </div>
    </div>
  {{/if}}
  <li class='item flexrow items-header'>
    <div class='item-name'>{{#if materialshow.all}}{{localize "SW25.Item.Name"}}{{else}}{{localize "TYPES.Item.alchemytech"}}{{/if}}</div>
    <div class='item-element' style="flex: 0 0 120px;">{{localize "SW25.Cost"}}</div>
    <div class='item-element sidebar-hidden' style="flex: 0 0 120px;">{{localize "SW25.Rangeshape"}}</div>
    <div class='item-element sidebar-hidden' style="flex: 0 0 40px;">{{localize "SW25.Item.Resist"}}</div>
    {{> "systems/sw25/templates/actor/parts/actor-item-create.hbs" type="alchemytech"}}
  </li>
  {{#each alchemytechs as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        {{> "systems/sw25/templates/actor/parts/actor-item-rowhead.hbs" item=item}}
        {{> "systems/sw25/templates/actor/parts/actor-useitems.hbs" item=item}}
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 60px;">
          {{#unless (eq system.red 0)}} {{localize "SW25.Item.Alchemytech.Red"}}{{system.red}}{{/unless}}
          {{#unless (eq system.green 0)}} {{localize "SW25.Item.Alchemytech.Green"}}{{system.green}}{{/unless}}
          {{#unless (eq system.black 0)}} {{localize "SW25.Item.Alchemytech.Black"}}{{system.black}}{{/unless}}
          {{#unless (eq system.white 0)}} {{localize "SW25.Item.Alchemytech.White"}}{{system.white}}{{/unless}}
          {{#unless (eq system.gold 0)}} {{localize "SW25.Item.Alchemytech.Gold"}}{{system.gold}}{{/unless}}
        </div>
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 60px;">
          <div class="materialcardcost">B</div>
          <div class="materialcardcost">A</div>
          <div class="materialcardcost">S</div>
          <div class="materialcardcost">SS</div>
        </div>
        <div class='item-prop flexrow flex-group-center sidebar-hidden' style="flex: 0 0 120px;">
          {{system.rangeshape}}
        </div>
        <div class='item-prop flexrow flex-group-center sidebar-hidden' style="flex: 0 0 40px;">
          {{system.resistname}}
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-item-controls.hbs" type="alchemytech" mode="equip" isOwner=../isOwner isEdit=../system.isEdit}}
      </div>
      {{> "systems/sw25/templates/actor/parts/actor-item-description.hbs"}}
    </li>
  {{/each}}
</ol>
