<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "TYPES.Item.combatability"}}</div>
    <div class='item-element sidebar-hidden' style="flex: 1 0 0;">{{localize "SW25.Item.Combatability.App"}} / {{localize "SW25.Item.Combatability.Risk"}}</div>
    {{> "systems/sw25/templates/actor/parts/actor-item-create.hbs" type="combatability"}}
  </li>
  {{#each combatabilities as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        {{> "systems/sw25/templates/actor/parts/actor-item-rowhead.hbs" item=item}}
        {{> "systems/sw25/templates/actor/parts/actor-useitems.hbs" item=item}}
        <div class='item-prop flexrow flex-group-center sidebar-hidden' style="flex: 1 0 0;">
          {{#if system.app}}{{system.app}}{{else}}-{{/if}} / {{#if system.risk}}{{system.risk}}{{else}}-{{/if}}
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-item-controls.hbs" type="combatability" mode="equip" viewLabel="DOCUMENT.View" isOwner=../isOwner isEdit=../system.isEdit}}
      </div>
      <div class="item-description nogapmargin">
        <div class="flexrow">
          <div style="flex: 0 0 60px;"></div>
          <div style="font-size: 0.8em;">
            {{#if system.secret}}{{system.school}}<hr>{{/if}}
            {{{system.description}}}
          </div>
          <div style="flex: 0 0 50px;"></div>
        </div>
      </div>
    </li>
  {{/each}}
</ol>
