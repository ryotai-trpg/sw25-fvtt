{{!--
  行動表(フェロー / デーモン)の 1 行。{{#each}} の中から

    {{> ... item=item nameWidth="150px" isOwner=../isOwner isEdit=../system.isEdit}}

  の形で呼ぶ(`../` は呼び出し側で解決させる)。

    nameWidth   名前欄の幅。フェロー 150px / デーモン 120px
    showTarget  デーモン表だけが持つ「対象」の欄
    isOwner     操作ボタンの出し分け。**ほとんどの表は持ち主かどうかを
                見ずに編集・削除を出しているので、そこは true を渡す**
--}}
<li class='item action' data-item-id='{{item._id}}'>
  <div class="flexrow flex-group-center">
    <div class='item-name' style="flex: 0 0 {{nameWidth}};">
      <div class='item-image'>
        <a class='rollable' data-roll-type='item'>
          <img class="roll-icon" src='{{item.img}}' title='{{item.name}}'/>
        </a>
      </div>
      <h4 class="action-label">{{item.name}}</h4>
    </div>
    <div class='item-name action-label item-prop'>{{{system.displayaction}}}</div>
    {{> "systems/sw25/templates/actor/parts/actor-useitems.hbs" item=item}}
    <div class="mpcost" style="flex: 0 0 40px; display: {{#if system.mpcost}}block{{else}}none{{/if}};" data-cost="{{item.system.mpcost}}" data-label="{{item.name}}" data-type="{{item.type}}">
      <b>{{localize "SW25.Item.MPB"}}</b>
    </div>
    {{#if showTarget}}
      <div class='item-prop flexrow flex-group-center' style="flex: 0 0 100px;">{{system.target}}</div>
    {{/if}}
    <div class='rollable item-prop flexrow flex-group-center' style="flex: 0 0 60px;" data-roll="{{item.system.checkformula1}}+{{item.system.checkbase1}}" data-label="{{item.name}} ({{localize "SW25.Item.Action.ActionValue"}})" data-pt="{{item.system.powertable}}" data-apply="{{system.applycheck1}}" data-checktype="{{system.checkTypesButton1}}" {{resistAttributes type system.dice1.resist}}>
      {{system.actionvalue}} ({{system.actionresult}})
    </div>
  </div>
  <div class="action-description nogapmargin">
    <div class="flexrow">
      <div style="flex: 0 0 60px;"></div>
      <div class="flexcol textalign-left" style="font-size: 0.8em;">
        {{#if system.dialog}}<span><b>{{localize "SW25.Item.Action.Dialog"}}:</b> {{system.dialog}}</span>{{/if}}
        {{#if system.displayactioneffect}}
        <span><b>{{localize "SW25.Item.Action.ActionEffect"}}:</b></span>
        <span>{{{system.displayactioneffect}}}</span>
        {{/if}}
        {{#if system.description}}
        <span><b>{{localize "SW25.Description"}}:</b></span>
        <span>{{{system.description}}}</span>
        {{/if}}
      </div>
      {{> "systems/sw25/templates/actor/parts/actor-item-controls.hbs" type="action" mode="always" style="flex: 0 0 50px;" isOwner=isOwner isEdit=isEdit}}
    </div>
  </div>
</li>
