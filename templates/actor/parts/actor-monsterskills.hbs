{{!-- enhancearts --}}
<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "TYPES.Item.enhancearts"}}</div>
    <div class='item-element' style="flex: 0 0 50px;">MP</div>
    <div class='item-element' style="flex: 0 0 100px;">{{localize "SW25.Time"}}</div>
    {{> "systems/sw25/templates/actor/parts/actor-item-create.hbs" type="enhancearts"}}
  </li>
  {{#each enhancearts as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        <div class="item-equip">
          {{#if system.useequip}}
          <label class="equip-toggle">
            <input class="eq-change" type="checkbox" name="system.equip" data-dtype="Boolean" {{#if system.equip}} checked {{/if}}/>
          </label>
          {{/if}}
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-item-rowhead.hbs" item=item}}
        {{> "systems/sw25/templates/actor/parts/actor-useitems.hbs" item=item}}
        <div class='mpcost item-prop flexrow flex-group-center' style="flex: 0 0 50px;" data-cost="{{item.system.mpcost}}" data-label="{{item.name}}" data-type="{{item.type}}">
          {{system.mpcost}}
        </div>
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 100px;">
          {{system.time}} 
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-item-controls.hbs" type="enhancearts" mode="always" isOwner=../isOwner isEdit=../system.isEdit}}
      </div>
      {{> "systems/sw25/templates/actor/parts/actor-item-description.hbs"}}
    </li>
  {{/each}}
</ol>

{{!-- magicalsong --}}
<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "TYPES.Item.magicalsong"}}</div>
    <div class='item-element' style="flex: 0 0 40px;">{{localize "SW25.Item.Resist"}}</div>
    <div class='item-element' style="flex: 0 0 80px;">{{localize "SW25.Item.Prop"}}</div>
    {{> "systems/sw25/templates/actor/parts/actor-item-create.hbs" type="magicalsong"}}
  </li>
  {{#each magicalsongs as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        <div class="item-equip">
          {{#if system.useequip}}
          <label class="equip-toggle">
            <input class="eq-change" type="checkbox" name="system.equip" data-dtype="Boolean" {{#if system.equip}} checked {{/if}}/>
          </label>
          {{/if}}
        </div>
        <div class='item-name'>
          <div class='item-image'>
            <a class='rollable' data-roll-type='item'>
              <img class="roll-icon" src='{{item.img}}' title='{{item.name}}'/>
            </a>
          </div>
          {{> "systems/sw25/templates/helper/action-marks.hbs"}}
          <{{system.typename}}><h4 class="item-label">{{item.name}}</h4>
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-useitems.hbs" item=item}}
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 40px;">
          {{system.resistname}}
        </div>
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 80px;">
          {{system.propname}}
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-item-controls.hbs" type="enhancearts" mode="always" isOwner=../isOwner isEdit=../system.isEdit}}
      </div>
      {{> "systems/sw25/templates/actor/parts/actor-item-description.hbs"}}
    </li>
  {{/each}}
</ol>

