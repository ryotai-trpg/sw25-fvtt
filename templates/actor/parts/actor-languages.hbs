<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "TYPES.Item.language"}}</div>
    <div class='item-element' style="flex: 0 0 30px;">{{localize "SW25.Item.Language.Conversation"}}</div>
    <div class='item-element' style="flex: 0 0 30px;">{{localize "SW25.Item.Language.Reading"}}</div>
    <div class='item-controls' style="flex: 0 0 60px;">
      <a class='item-control item-create' title='{{localize "DOCUMENT.Create" type=(localize "TYPES.Item.language")}}' data-type='language'>
        <i class='fas fa-plus'></i>
        {{localize 'DOCUMENT.New' type=''}}
      </a>
    </div>
  </li>
  {{#each languages as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        <div class='item-name' style="flex: 3;"><h4>{{item.name}}</h4></div>
        <div class="flex-group-center" style="flex: 0 0 30px;">
          <input class="cv-change" type="checkbox" name="system.conversation" data-dtype="Boolean" {{#if system.conversation}} checked {{/if}}{{#unless ../system.isEdit}} disabled{{/unless}}/>
        </div>
        <div class="flex-group-center" style="flex: 0 0 30px;">
          <input class="rd-change" type="checkbox" name="system.reading" data-dtype="Boolean" {{#if system.reading}} checked {{/if}}{{#unless ../system.isEdit}} disabled{{/unless}}/>
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-item-controls.hbs" type="language" mode="isEdit" isOwner=../isOwner isEdit=../system.isEdit}}
      </div>
    </li>
  {{/each}}
</ol>
