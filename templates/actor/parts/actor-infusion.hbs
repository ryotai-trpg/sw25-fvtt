<ol class='items-list'>
  <li class='item flexrow items-header'>
    <div class='item-name'>{{localize "TYPES.Item.infusion"}}</div>
    <div class='item-element' style="flex: 0 0 110px;">{{localize "SW25.Item.Part"}}</div>
    <div class='item-element' style="flex: 0 0 110px;">{{localize "SW25.Item.Infusion.HumanoidForm"}}</div>
    {{> "systems/sw25/templates/actor/parts/actor-item-create.hbs" type="infusion"}}
  </li>
  {{#each infusion as |item id|}}
    <li class='item' data-item-id='{{item._id}}'>
      <div class="flexrow flex-group-center">
        {{> "systems/sw25/templates/actor/parts/actor-item-rowhead.hbs" item=item}}
        {{> "systems/sw25/templates/actor/parts/actor-useitems.hbs" item=item}}
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 120px;">
          {{system.itpart}}
        </div>
        <div class='item-prop flexrow flex-group-center' style="flex: 0 0 110px;">
          {{system.humanoid}}
        </div>
        {{> "systems/sw25/templates/actor/parts/actor-item-controls.hbs" type="infusion" mode="equip" isOwner=../isOwner isEdit=../system.isEdit}}
      </div>
      {{> "systems/sw25/templates/actor/parts/actor-item-description.hbs"}}
    </li>
  {{/each}}
</ol>
