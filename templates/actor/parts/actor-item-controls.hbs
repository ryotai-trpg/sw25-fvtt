{{!--
  アイテム行の右端の操作ボタン。{{#each}} の中から

    {{> ... type="weapon" mode="isEdit" isOwner=../isOwner isEdit=../system.isEdit}}

  の形で呼ぶ(`../` は呼び出し側で解決させる)。

  mode
    always  編集 + 削除を常に出す
    isEdit  編集 +(編集モードのときだけ)削除
    equip   編集 +(編集モードなら削除、そうでなければ装備チェック)

  style   枠に付ける追加のスタイル(battle タブの一覧だけ幅を固定している)
--}}
{{#if isOwner}}
  <div class='item-controls'{{#if style}} style="{{style}}"{{/if}}>
    <a class='item-control item-edit' title='{{localize "DOCUMENT.Update" type=(localize (concat "TYPES.Item." type))}}'>
      <i class='fas fa-edit'></i>
    </a>
    {{#if (eq mode "always")}}
      <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize (concat "TYPES.Item." type))}}'>
        <i class='fas fa-trash'></i>
      </a>
    {{else}}
      {{#if isEdit}}
        <a class='item-control item-delete' title='{{localize "DOCUMENT.Delete" type=(localize (concat "TYPES.Item." type))}}'>
          <i class='fas fa-trash'></i>
        </a>
      {{else}}
        {{#if (eq mode "equip")}}
          {{> "systems/sw25/templates/actor/parts/actor-item-equip.hbs"}}
        {{/if}}
      {{/if}}
    {{/if}}
  </div>
{{else}}
  <div class='item-controls'{{#if style}} style="{{style}}"{{/if}}>
    <a class='item-control item-edit' title='{{localize "DOCUMENT.View" type=(localize (concat "TYPES.Item." type))}}'>
      <i class='fa-solid fa-eye'></i>
    </a>
    {{#if (eq mode "equip")}}
      {{> "systems/sw25/templates/actor/parts/actor-item-equip.hbs"}}
    {{/if}}
  </div>
{{/if}}
